    private void jButton3ActionPerformed(java.awt.event.ActionEvent evt) {                                         
        String languages,communication,networksecurity,operatingsystem,frameworks,others,query;
        String SUrl,SUser,Spass;
        SUrl= "jdbc:mysql://localhost:3306/login";
        SUser="root";
        Spass="ROOT";
        try{
            Class.forName("com.mysql.cj.jdbc.Driver");
            Connection con =DriverManager.getConnection(SUrl,SUser,Spass);
            Statement st=con.createStatement();
            if("".equals(jTextField2.getText())){
                JOptionPane.showMessageDialog(new JFrame(),"Communication is Require", "error",JOptioPane.ERROR_MESSAGE);
        }else{
              languages=jTextField1.getText();
              communication=jTextField2.getText();
              networksecurity=jTextField3.getText();
              operatingsystem=jTextField4.getText();
              frameworks= jTextField5.getText();
              others= jTextField6.getText();
              query="insert into skill(languages,communication,networksecurity,operatingsystem,frameworks,others)"+
                      "values('"+languages+"','"+communication+"','"+networksecurity+"','"+operatingsystem+"','"+frameworks+"','"+others+"')";
              st.execute(query);
              showMessageDialog(null,"Skill Saved Successfully!");
            }
        }catch(Exception e)
        {
          System.out.println("Error!"+e.getMessage());   
        }    
    }                                        

