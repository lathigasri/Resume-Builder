    private void jButton2ActionPerformed(java.awt.event.ActionEvent evt) {                                         
        String university,city,batch,percentage,university1,city1,batch1,percentage1,query;
        String SUrl,SUser,Spass;
        SUrl= "jdbc:mysql://localhost:3306/login";
        SUser="root";
        Spass="ROOT";
        try{
            Class.forName("com.mysql.cj.jdbc.Driver");
            Connection con =DriverManager.getConnection(SUrl,SUser,Spass);
            Statement st=con.createStatement();
            if("".equals(jTextField8.getText())){
                JOptionPane.showMessageDialog(new JFrame(),"University name is Require", "error",JOptioPane.ERROR_MESSAGE);
            }else if("".equals(jTextField1.getText())){
                JOptionPane.showMessageDialog(new JFrame(),"City is Require", "error",JOptioPane.ERROR_MESSAGE);
            }else if("".equals(jTextField4.getText())){
                JOptionPane.showMessageDialog(new JFrame(),"Batch is Require", "error",JOptioPane.ERROR_MESSAGE);
            }else if("".equals(jTextField3.getText())){
                JOptionPane.showMessageDialog(new JFrame(),"Percentage is Require", "error",JOptioPane.ERROR_MESSAGE);
        }else{
              university=jTextField8.getText();
              city=jTextField1.getText();
              batch=jTextField4.getText();
              percentage=jTextField3.getText();
              university1= jTextField6.getText();
              city1= jTextField5.getText();
              batch1=jTextField2.getText();
              percentage1=jTextField7.getText();
              query="insert into college(university,ccity,cbatch,cpercentage,university1,ccity1,cbatch1,cpercentage1)"+
                      "values('"+university+"','"+city+"','"+batch+"','"+percentage+"','"+university1+"','"+city1+"','"+batch1+"','"+percentage1+"')";
              st.execute(query);
              showMessageDialog(null,"College Details Saved Successfully!");
            }
        }catch(Exception e)
        {
          System.out.println("Error!"+e.getMessage());   
        }    
    }                                        

