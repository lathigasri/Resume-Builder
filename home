    private void jButton2ActionPerformed(java.awt.event.ActionEvent evt) {                                         
        String FirstName,lastname,phone,email,linkedin,address,github,query;
        String SUrl,SUser,Spass;
        SUrl= "jdbc:mysql://localhost:3306/login";
        SUser="root";
        Spass="ROOT";
        try{
            Class.forName("com.mysql.cj.jdbc.Driver");
            Connection con =DriverManager.getConnection(SUrl,SUser,Spass);
            Statement st=con.createStatement();
            if("".equals(fname.getText())){
                JOptionPane.showMessageDialog(new JFrame(),"First name is Require", "error",JOptioPane.ERROR_MESSAGE);
            }else if("".equals(phone1.getText())){
                JOptionPane.showMessageDialog(new JFrame(),"Phone num is Require", "error",JOptioPane.ERROR_MESSAGE);
            }else if("".equals(emailadd.getText())){
                JOptionPane.showMessageDialog(new JFrame(),"Email is Require", "error",JOptioPane.ERROR_MESSAGE);
            }else if("".equals(jTextField7.getText())){
                JOptionPane.showMessageDialog(new JFrame(),"Address is Require", "error",JOptioPane.ERROR_MESSAGE);
        }else{
              FirstName=fname.getText();
              lastname=jTextField2.getText();
              phone=phone1.getText();
              email=emailadd.getText();
              linkedin = jTextField5.getText();
             github = github1.getText();
              address=jTextField7.getText();
              query="insert into deatils(FirstName,lastname,phone,email,linkedin,github,address)"+
                      "values('"+FirstName+"','"+lastname+"','"+phone+"','"+email+"','"+linkedin+"','"+github+"','"+address+"')";
              st.execute(query);
              showMessageDialog(null,"Personal Details Saved Successfully!");
            }
        }catch(Exception e)
        {
          System.out.println("Error!"+e.getMessage());   
        }        
    }                                        

