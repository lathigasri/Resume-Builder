    private void jButton2ActionPerformed(java.awt.event.ActionEvent evt) {                                         
        String summary,query;
        String SUrl,SUser,Spass;
        SUrl= "jdbc:mysql://localhost:3306/login";
        SUser="root";
        Spass="ROOT";
        try{
            Class.forName("com.mysql.cj.jdbc.Driver");
            Connection con =DriverManager.getConnection(SUrl,SUser,Spass);
            Statement st=con.createStatement();
            if("".equals(jTextField1.getText())){
                JOptionPane.showMessageDialog(new JFrame(),"Professional Summary is Require", "error",JOptioPane.ERROR_MESSAGE);
            }else{
              summary=jTextField1.getText();
              query="insert into professional(summary)"+
                      "values('"+summary+"')";
              st.execute(query);
              showMessageDialog(null,"Professional Summary Saved Successfully!");
            }
        }catch(Exception e)
        {
          System.out.println("Error!"+e.getMessage());   
        }        
    }                                        

